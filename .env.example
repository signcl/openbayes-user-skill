# Copy this template to your working directory before running scripts.
# Examples:
#   cp .env.example .env.openbayes
#   cp .env.example .env.hyperai
#   cp .env.example .env.custom
# Optional runtime settings only; authentication requires --login.
# Or keep shared settings in:
#   ~/.config/openbayes-skills/.env.<vendor>

# Vendor label for human reference only (optional)
# VENDOR_NAME=openbayes

# GraphQL endpoint used to start login when no session exists.
# An active session always uses its own bound endpoint.
# Leave blank for official vendors — the runtime fills these in by --vendor:
#   openbayes -> https://openbayes.com/gateway/graphql
#   hyperai   -> https://app.hyper.ai/gateway/graphql
# Set this only for private / in-cluster / other custom environments.
OPENBAYES_GRAPHQL_ENDPOINT=

# Tokens in this file or OPENBAYES_TOKEN in the process environment are ignored.
# Run scripts/run_graphql.sh --login --vendor <name> to authorize.

# Optional: TLS certificate verification (default: true)
# OPENBAYES_SSL_VERIFY=true

# Optional: public-facing base URL for in-cluster deployments.
# Set this when OPENBAYES_GRAPHQL_ENDPOINT points at an internal cluster host
# (e.g. http://openbayes-graphql-gateway/graphql). The script rewrites any
# response URL whose host matches the internal endpoint to use this base, so
# `links.value` stays clickable from outside the cluster.
# Example: OPENBAYES_PUBLIC_BASE_URL=https://openbayes.com
